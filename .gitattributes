# ============================================================
#  RaagaX — Git Line Endings
# ============================================================

# Default — let Git decide
* text=auto

# Shell scripts MUST have LF — will break on Mac/Linux with CRLF
*.sh text eol=lf

# Windows batch files MUST have CRLF
*.bat text eol=crlf

# Python — LF everywhere
*.py text eol=lf

# Web files — LF
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf

# Spec file — LF
*.spec text eol=lf

# Binaries — no conversion
*.exe binary
*.icns binary
*.ico binary
*.png binary
*.jpg binary